POSTGRES_DB=pado
POSTGRES_USER=pado
POSTGRES_PASSWORD=change_me
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/pado
SPRING_DATASOURCE_USERNAME=pado
SPRING_DATASOURCE_PASSWORD=change_me
JWT_SECRET=replace_with_at_least_32_random_characters
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# VietQR membership payments
PAYMENT_MOCK_ENABLED=false
VIETQR_BANK_ID=970436
VIETQR_BANK_NAME=Vietcombank
VIETQR_ACCOUNT_NUMBER=your_bank_account_number
VIETQR_ACCOUNT_NAME=YOUR ACCOUNT NAME
VIETQR_TEMPLATE=compact2

# MVP demo OTP. The generated code is returned to the frontend for verification.
EMAIL_PROVIDER=log
AUTH_OTP_EXPOSE_CODE=true
AUTH_OTP_EXPIRATION_MINUTES=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_OTP_MAX_ATTEMPTS=5

# Production email (enable only after verifying a sending domain in Resend)
RESEND_API_KEY=re_replace_me
EMAIL_FROM=PADO <verify@your-verified-domain.com>

# Cloudinary server-side upload
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
# Copy API Secret from Cloudinary Console > Settings > API Keys. It is not the API Key.
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=pado/products
